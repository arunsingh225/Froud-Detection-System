# ============================================================================
# FraudGuard AI — Environment Variables
# Copy to .env and configure before running services.
# ============================================================================

# --- ASP.NET Core Backend (Port 5000) ---
# JWT signing key (must be >= 32 bytes / 256 bits)
JWT_SECRET_KEY="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG"

# SQL Server connection string
CONNECTIONSTRINGS__DEFAULTCONNECTION="Server=(localdb)\\MSSQLLocalDB;Database=FraudGuardAI_DB;Trusted_Connection=True;TrustServerCertificate=True;"

# --- FastAPI AI Engine (Port 8000) ---
# Shared secret for internal microservice authentication (ASP.NET → FastAPI)
FASTAPI_INTERNAL_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# Model artifact paths (relative to project root)
MODEL_PATH="models/fraud_model.pkl"
PREPROCESSING_PATH="models/preprocessing.pkl"
METADATA_PATH="models/model_metadata.json"
